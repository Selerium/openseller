# Local env files. The .example.env.* files next to them are the committed templates.
config/.env.*

# Deploy script state. Single source of truth for a self-hosted install, and it holds
# secrets — never commit it.
.deploy.env

# Nightly pg_dump output. The directory itself is tracked via .gitkeep; the dumps are
# the whole database and must not be committed.
backups/*
!backups/.gitkeep

# Uploaded product media. The directory itself is tracked via .gitkeep so the bind mount
# has somewhere to land; its contents are user data and must not be committed.
backups/*
uploads/*
!uploads/.gitkeep

# Build output and dependencies. .next-docker is the Docker-mode distDir (see next.config.ts),
# kept separate so standalone and Docker dev servers can both hold their PID lock.
frontend/.next/
frontend/.next-docker/
frontend/node_modules/
backend/node_modules/
backend/src/generated/

# TypeScript
*.tsbuildinfo
frontend/tsconfig.tsbuildinfo

# TLS material, if certs are ever issued into the repo rather than the volume
nginx/certs/

# Editor and OS noise
.DS_Store
*.swp
.idea/
.vscode/
*.log
npm-debug.log*
