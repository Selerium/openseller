# Public base URL of the storefront. Used for absolute links (Stripe redirects, email).
# In single-origin Docker mode the frontend is served by nginx on the same host as the API,
# so this is normally just https://yourdomain. Leave blank in local dev.
NEXT_PUBLIC_STORE_URL=""

# Where the browser sends API requests.
#
# Leave this UNSET in Docker mode: nginx serves the API at /api on the same origin, so a
# relative base means no CORS and no cookie configuration at all.
#
# In standalone dev, set it to http://localhost/api when nginx is running on :80, or to
# http://localhost:3000 for something that will be reached directly. Note that the bind
# mounted container reads this file too, so prefer passing the value on the command line
# (NEXT_PUBLIC_API_URL=... npm run dev) rather than committing it.
NEXT_PUBLIC_API_URL=""

# Currency code (ISO 4217) as displayed across the storefront. Letters only, no symbol.
# Must match STORE_CURRENCY in .env.backend, since the backend is authoritative for prices.
NEXT_PUBLIC_STORE_CURRENCY="usd"