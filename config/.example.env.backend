DATABASE_URL="postgres://user:password@db:5432/mydb"

# Comma separated list of allowed browser origins for authenticated requests.
# Used with CORS credentials, so an origin missing from here fails every authed call,
# not just the preflight. Local dev defaults to localhost:3000 and localhost:80 if unset.
FRONTEND_URL=""

JWT_SECRET="this_is_a_long_test_string_for_jwt_secret_for_now_only"

RESEND_API_KEY=""

NODE_ENV=""

# --- commerce ---
STRIPE_SECRET_KEY=""

# The pk_test_/pk_live_ counterpart of the secret key above. Needed only for saving a card on
# /profile/payment-methods, which mounts a Stripe Element in the page; checkout itself is a
# redirect to Stripe-hosted Checkout and never loads Stripe.js.
#
# Left blank here rather than guessed: it is not derivable from the secret key, and a wrong value
# fails inside Stripe's script rather than at boot. The payment-methods page reports "not
# configured" while this is empty instead of erroring.
STRIPE_PUBLISHABLE_KEY=""

STRIPE_WEBHOOK_SECRET=""

# Local-only stand-in for Stripe Checkout, for running the whole stack with no external
# accounts. Off unless set to exactly "true", and refused outright when PROD=true because it
# confirms orders without charging anyone. Never enable this on a live store.
ALLOW_MOCK_PAYMENTS="false"

# Public base URL of the STOREFRONT (the Next app), not the API. Must be https in production.
#
# Stripe redirects to /checkout/success, and verification / password-reset emails link to
# /verify-email and /reset-password. These are all frontend routes, so pointing this at the
# API origin produces links that return 401 rather than failing loudly.
#
# Set this explicitly. Leaving it blank falls back to http://localhost, which is right for
# `make dev` but wrong for any real deployment, and the failure is silent: the process boots
# and only the links break later.
STORE_URL="http://localhost"

# Public-facing shop name. Shown in email subjects/bodies and mirrored to the
# storefront header/homepage via NEXT_PUBLIC_STORE_NAME, which should always match.
STORE_NAME="sampledomain"

# Sender for every outbound email. Use an address on a domain you control in Resend.
EMAIL_FROM="do-not-reply@sampledomain.ae"

# ISO 4217 code for every price in the store, e.g. usd, eur, aed, jpy.
# Letters only: prices are rendered as "18.50 USD", never with a currency symbol, because the
# symbol for a code is locale-dependent and that would make server-rendered prices differ
# between browsers. Must match NEXT_PUBLIC_STORE_CURRENCY in .env.frontend.
STORE_CURRENCY="usd"

# Default per-variant threshold for the admin "nearing out of stock" report. Individual
# variants can override it via Variant.lowStockThreshold.
LOW_STOCK_THRESHOLD="5"

# --- cookies ---
# SameSite policy for the auth cookies. Leave unset for single-origin deployments.
# "lax" also covers standalone dev, since SameSite compares registrable domains and ignores
# ports, so localhost:3000 -> localhost:80 sends cookies fine.
# Set to "none" ONLY when the API and frontend are on genuinely different domains; that forces
# Secure and requires FRONTEND_URL to list the frontend origin exactly.
# COOKIE_SAME_SITE="lax"

# Shared parent domain when API and frontend are subdomains of one domain, e.g.
# ".example.com" for api.example.com + shop.example.com. Leave blank when they share an
# origin. Setting this implies SameSite=none unless COOKIE_SAME_SITE overrides it.
COOKIE_DOMAIN=""

# --- idempotency ---
# Redis holds the Idempotency-Key records the frontend sends with every mutating request.
# Internal only: /login responses are replayed with their Set-Cookie, so this holds live
# session tokens. Do not publish 6379.
REDIS_URL="redis://redis:6379"

# How long a completed response stays replayable. Long enough to cover a user who abandons a
# form and comes back to it, short enough that the token material in it does not linger.
IDEMPOTENCY_TTL_SECONDS="86400"

# How long an in-flight request holds its key before another attempt may take it. Deliberately
# far below the TTL: this is what stops a process that dies mid-request from wedging a key
# until the long TTL expires.
IDEMPOTENCY_LEASE_SECONDS="60"

# How long a duplicate waits for the original to finish before returning 409.
IDEMPOTENCY_WAIT_MS="3000"